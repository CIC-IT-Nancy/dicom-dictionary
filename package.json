{
  "name": "@cic-it-nancy/dicom-dictionary",
  "version": "1.0.0",
  "description": "DICOM Dictionary",
  "license": "LGPL-3.0",
  "author": "CIC-IT Nancy",
  "repository": "https://github.com/CIC-IT-Nancy/dicom-dictionary",
  "bugs": "https://github.com/CIC-IT-Nancy/dicom-dictionary/issues",
  "contributors": [
    {
      "name": "Pierre 'AlasDiablo' M",
      "url": "https://github.com/AlasDiablo"
    }
  ],
  "scripts": {
    "build": "npm run build:typescript && npm run build:browser && npm run build:browser:min",
    "build:typescript": "tsc -b ./tsconfig.cjs.json ./tsconfig.esm.json",
    "build:browser": "esbuild ./lib/esm/index.js --bundle --platform=browser --outfile=./lib/browser.js",
    "build:browser:min": "esbuild ./lib/esm/index.js --bundle --platform=browser --minify --outfile=./lib/browser.min.js",
    "prepublish": "npm run build"
  },
  "type": "module",
  "main": "./lib/cjs/index.js",
  "module": "./lib/esm/index.js",
  "types": "./lib/types/index.d.ts",
  "files": [
    "./lib/*"
  ],
  "devDependencies": {
    "@eslint/js": "~9.39.5",
    "@stylistic/eslint-plugin": "~5.10.0",
    "esbuild": "~0.28.2",
    "eslint": "~9.39.5",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-import": "~2.32.0",
    "eslint-plugin-prettier": "~5.5.7",
    "globals": "~17.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.72.1"
  }
}
